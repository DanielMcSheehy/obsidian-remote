# Only thing you MUST set in Coolify: one password for the whole app.
# Leave empty = open (no auth) for local dev.
APP_PASSWORD=your-strong-password-here
# optional: vault DB name (single default vault). Default: obsidian
VAULT_NAME=obsidian

# CouchDB is internal-only (not mapped to host). Hardcoded inside compose — no need to set.
# COUCHDB_USER=admin
# COUCHDB_PASSWORD=obsidian-remote-internal-do-not-expose

PORT=3000
DATA_DIR=/data
# PUBLIC_URL auto-detected from Coolify SERVICE_FQDN_APP
